# ——— required ———
DATABASE_URL="postgresql://user:pass@localhost:5432/foodiy"
JWT_SECRET="change-me-to-32-random-bytes-base64"
OPENAI_API_KEY="sk-..."

# ——— optional (defaults shown) ———
OPENAI_MODEL="gpt-5.4"
UPLOADS_DIR="./uploads"          # on Railway: /data/uploads
NEXT_PUBLIC_APP_NAME="Foodiy"

# ——— first-run only ———
# Required to register the very first account (admin). Unset after setup.
ADMIN_SETUP_TOKEN="one-time-token-you-choose"
